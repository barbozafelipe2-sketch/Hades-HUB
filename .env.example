# KAIROS V7.3 — server-side configuration only.
# Netlify AI Gateway injects LLM provider credentials automatically in production.
# Do NOT add OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY
# unless you intentionally want to override Netlify AI Gateway.

# Legacy owner migration bridge only. New commercial users authenticate with Netlify Identity.
# Canonical names are KAIROS_*. Legacy SAURON_* / HADES_* remain accepted until the owner
# migration is verified in production. If both are set, KAIROS_* wins. Do not remove the
# legacy names from Netlify until that check passes.
KAIROS_ADMIN_USER=
KAIROS_ADMIN_PASSWORD=
KAIROS_SESSION_SECRET=
KAIROS_INTERNAL_SECRET=
SAURON_ADMIN_USER=admin
SAURON_ADMIN_PASSWORD=replace-with-a-strong-private-password
SAURON_SESSION_SECRET=replace-with-64-plus-random-characters
HADES_INTERNAL_SECRET=replace-with-a-different-64-plus-random-value
KAIROS_ADMIN_EMAIL=
KAIROS_BOOTSTRAP_TENANT_NAME=Kairos Workspace
KAIROS_LEGACY_AUTH_ENABLED=false

# Commercial data backend. Hosted KAIROS defaults to Postgres/Netlify Database even if omitted.
# Keep `postgres` for commercial deployments. `blobs` exists only as an emergency compatibility rollback.
KAIROS_DATA_BACKEND=postgres

# Owner licensed feed is primary. Twelve Data then Finnhub are per-symbol fallback only.
KAIROS_LICENSED_MARKET_BASE_URL=
KAIROS_LICENSED_MARKET_API_KEY=
KAIROS_LICENSED_MARKET_LICENSE_ID=
KAIROS_MARKET_DELAY_CLASS=unknown
TWELVE_DATA_API_KEY=
TWELVE_DATA_LICENSE_ID=
FINNHUB_API_KEY=
FINNHUB_LICENSE_ID=

# Optional macro/geopolitical Trace Lab source. Server-only endpoint contract is documented in COMMERCIAL_READINESS.md.
# The provider must return point-in-time rows with publication/availability timestamps and the configured license id.
KAIROS_TRACE_CONTEXT_BASE_URL=
KAIROS_TRACE_CONTEXT_API_KEY=
KAIROS_TRACE_CONTEXT_LICENSE_ID=
# KAIROS_TRACE_CONTEXT_TIMEOUT_MS=3500

# Commercial account gate — public signup stays CLOSED until every legal field is configured.
KAIROS_ALLOW_SIGNUPS=false
KAIROS_PUBLIC_SIGNUP_READY=false
KAIROS_LEGAL_ENTITY_NAME=
KAIROS_TERMS_VERSION=
KAIROS_TERMS_URL=
KAIROS_RISK_DISCLOSURE_VERSION=
KAIROS_RISK_DISCLOSURE_URL=
KAIROS_PRIVACY_URL=


# Web billing — optional until you are ready to accept paid subscriptions.
# KAIROS never exposes these values to the browser. Configure the Stripe webhook to
# /.netlify/functions/billing-webhook and use a recurring Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KAIROS_STRIPE_PRO_PRICE_ID=
KAIROS_APP_URL=
KAIROS_REQUIRE_BILLING_FOR_SIGNUP=true

# Commercial access/cost guardrails. These are internal relative AI units, not dollars/tokens.
KAIROS_TRIAL_DAYS=14
KAIROS_TRIAL_AI_UNITS=120
KAIROS_PRO_AI_UNITS=1200
KAIROS_OWNER_ENABLE_SOL=false
# Required before launch readiness can pass; values are daily USD hard caps.
KAIROS_TENANT_DAILY_USD=
KAIROS_SITE_DAILY_USD=
# Optional per-feature overrides:
# KAIROS_AI_UNITS_COACH_FAST=1
# KAIROS_AI_UNITS_COACH_DEEP=4
# KAIROS_AI_UNITS_DECISION_REVIEW=12
# KAIROS_AI_UNITS_AI_MIRROR=10
# KAIROS_AI_UNITS_WALLET_MIRROR=8
# KAIROS_AI_UNITS_LEARNING_LAB=16

# Optional tuning. Canonical KAIROS_* aliases are accepted and win if set:
# KAIROS_CHAT_TOTAL_BUDGET_MS, KAIROS_CHAT_PROVIDER_TIMEOUT_MS,
# KAIROS_CHAT_MAX_QUESTION_CHARS, KAIROS_JSON_PROVIDER_TIMEOUT_MS,
# KAIROS_MARKET_REFRESH_WALL_MS, KAIROS_MARKET_TIME_ZONE.
HADES_CHAT_TOTAL_BUDGET_MS=18000
HADES_CHAT_PROVIDER_TIMEOUT_MS=8000
HADES_CHAT_MAX_QUESTION_CHARS=12000
HADES_JSON_PROVIDER_TIMEOUT_MS=10000
HADES_MARKET_REFRESH_WALL_MS=48000
SAURON_MARKET_TIME_ZONE=America/New_York

# Trace recovery: bounded historical reconstruction batches.
# Aliases: KAIROS_CATCHUP_BATCH_SIZE, KAIROS_TRACE_MAX_SCAN_DAYS.
SAURON_CATCHUP_BATCH_SIZE=4
SAURON_TRACE_MAX_SCAN_DAYS=730

# Safety: keep the original private owner workspace non-deletable from the customer UI.
KAIROS_ALLOW_PRIVATE_OWNER_DELETE=false

# Final public-release gates. Keep false until the Git-backed Deploy Preview is smoke-tested
# and the intended public launch copy/legal posture has been reviewed.
KAIROS_PRODUCT_MODE=paper_research
KAIROS_REAL_MONEY_EXECUTION=false
KAIROS_PUBLIC_RELEASE_APPROVED=false
KAIROS_PREVIEW_SMOKE_APPROVED=false
KAIROS_LEGAL_REVIEW_VERSION=
KAIROS_LEGAL_REVIEWED_AT=
KAIROS_SUPPORT_EMAIL=
